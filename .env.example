# Rinomina questo file in ".env" e sostituisci con le tue chiavi Supabase.
# Le variabili con prefisso VITE_ sono esposte al frontend (necessario per Vite).
# La anon key è pubblica per design — Supabase usa Row Level Security per proteggere i dati.

VITE_SUPABASE_URL=https://tuoprogetto.supabase.co
VITE_SUPABASE_ANON_KEY=la_tua_chiave_anon_qui
